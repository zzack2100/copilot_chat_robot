{
  "name": "copilot",
  "version": "1.0.0",
  "description": "Copilot-Bot is a multi-platform chatbot for mobile and PC that connects to multiple AI model APIs through a unified experience. The project is designed around practical automation use cases, making it easier to build, run, and manage AI-assisted scripts and workflows from a single interface.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon src/server.ts",
    "dev:live": "set MCP_REVIEW_MODE=live&& set MCP_TRANSPORT=sse&& ts-node src/server.ts",
    "dev:quota:mock": "ts-node src/quota-mock-server.ts",
    "dev:quota:mock:429": "set QUOTA_MOCK_MODE=quota&& ts-node src/quota-mock-server.ts",
    "dev:quota:mock:500": "set QUOTA_MOCK_MODE=server-error&& ts-node src/quota-mock-server.ts",
    "dev:quota": "ts-node src/quota-lab.ts",
    "dev:quota:429": "set QUOTA_LAB_MODE=quota&& ts-node src/quota-lab.ts",
    "dev:quota:500": "set QUOTA_LAB_MODE=server-error&& ts-node src/quota-lab.ts",
    "dev:quota:offline": "set QUOTA_LAB_MODE=offline&& ts-node src/quota-lab.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run web:build",
    "build:all": "npm run build:server && npm run web:build",
    "start": "node dist-server/server.js",
    "smoke:mcp": "ts-node src/mcp-smoke-test.ts",
    "smoke:quota-lab": "ts-node src/quota-lab-smoke-test.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
